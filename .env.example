# MIRAI PATH — copy to .env and fill in locally. Never commit .env.
# API keys stay on the backend. The frontend must not receive them.

OPENAI_API_KEY=
GEMINI_API_KEY=

LLM_PROVIDER=openai

SEARCH_API_KEY=
SEARCH_PROVIDER=

DATABASE_URL=

CHROMA_PATH=./data/chroma

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
